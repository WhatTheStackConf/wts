# The directory must exist and contain an explicitly migrated database.
SITE_DATA_DIR=./.data
SITE_EDITION_ID=2027
SITE_ORIGIN=http://127.0.0.1:3308
# Enable only behind a proxy that replaces forwarded headers and blocks direct access.
SITE_TRUST_PROXY=false
PUBLIC_SITE_URL=https://wts.sh

# Register an exact /auth/callback separately before production deployment.
OIDC_ISSUER=https://auth.wts.sh
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Generate 32 random bytes and encode them as canonical base64url.
SITE_SESSION_KEY=

# Optional public newsletter settings. Keep the established list and site key.
VITE_LISTMONK_LIST_ID=
VITE_TURNSTILE_SITE_KEY=
