{
  "name": "@wts/site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.15.0"
  },
  "files": [
    ".output",
    "migrations",
    "scripts/site-data.ts",
    "src/server/storage.ts",
    "src/server/public-content.ts",
    "src/server/public-assets.ts",
    "src/lib/public-contract.ts",
    "src/lib/publication-schema.ts",
    "src/lib/public-slug.ts"
  ],
  "scripts": {
    "dev": "vp dev --port 3308",
    "build": "vp build && node ../scripts/check-server-bundle.mjs .output/server",
    "typecheck": "tsc --noEmit",
    "check": "vp check",
    "test": "pnpm test:storage && pnpm test:accounts && vp test run --maxWorkers=4",
    "start": "node .output/server/index.mjs",
    "data": "node --experimental-strip-types scripts/site-data.ts",
    "test:oidc": "node --experimental-strip-types tests/site-oidc.acceptance.mjs",
    "test:storage": "node --experimental-strip-types --test src/server/storage.test.ts src/server/recovery.test.ts",
    "test:accounts": "node --experimental-strip-types --test src/server/site-sessions.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@solidjs/meta": "^2.0.0",
    "@solidjs/router": "^2.0.0",
    "@solidjs/web": "^2.0.0",
    "entities": "^9.0.0",
    "fontkit": "3.0.0",
    "harfbuzzjs": "0.10.0",
    "nitro": "^3.0.261103-rc",
    "sanitize-html": "^2.18.2",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "sharp": "^0.35.5",
    "solid-js": "^2.0.0",
    "zod": "^4.6.7",
    "openid-client": "6.9.0"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@solidjs/vite-plugin": "^3.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/fontkit": "2.0.9",
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "daisyui": "^5.8.1",
    "filesystem-routing": "0.5.0",
    "gray-matter": "^4.0.3",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "openapi-types": "^12.1.3",
    "@apidevtools/swagger-parser": "^13.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
