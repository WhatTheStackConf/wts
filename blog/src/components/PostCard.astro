---
import type { ContentBylineCredit, EditProxy, MediaValue } from "emdash";
import { Image } from "emdash/ui";
import PostCardMeta from "./PostCardMeta.astro";

interface Props {
	title: string;
	excerpt?: string;
	featuredImage?: MediaValue | string;
	href: string;
	date?: Date;
	readingTime?: number;
	tags?: Array<{ slug: string; label: string }>;
	bylines?: ContentBylineCredit[];
	edit?: EditProxy;
}

const {
	title,
	excerpt,
	featuredImage,
	href,
	date,
	readingTime,
	tags,
	bylines,
	edit,
} = Astro.props;
---

<article class="post-card hair-panel">
	<a href={href} class="card-link" aria-label={`Read ${title}`}>
		{
			featuredImage && (
				<div class="card-image" {...edit?.featured_image}>
					<Image image={featuredImage} />
				</div>
			)
		}
		<div class="card-body">
			<PostCardMeta bylines={bylines} date={date} readingTime={readingTime} />
			<h2 class="card-title" {...edit?.title}>{title}</h2>
			{excerpt && <p class="card-excerpt" {...edit?.excerpt}>{excerpt}</p>}
		</div>
	</a>
	{
		tags && tags.length > 0 && (
			<div class="card-tags tag-list">
				{tags.slice(0, 2).map((tag) => (
					<a href={`/tag/${tag.slug}`} class="tag-chip">
						<span>{tag.label}</span>
					</a>
				))}
			</div>
		)
	}
</article>

<style>
	.post-card {
		display: flex;
		height: 100%;
		flex-direction: column;
		transition: border-color var(--fk-step) var(--ease-orbit-out);
	}

	/* Corner marks lock on in two steps when the card is hovered or focused. */
	.post-card::after {
		position: absolute;
		inset: 0.875rem;
		background: var(--mark-tl), var(--mark-br);
		opacity: 0;
		pointer-events: none;
		content: "";
		transition:
			opacity var(--fk-step) steps(2, end),
			inset var(--fk-step) steps(2, end);
	}

	.post-card:focus-within::after {
		inset: 0.5rem;
		opacity: 1;
	}

	.card-link {
		display: flex;
		flex: 1;
		flex-direction: column;
		color: inherit;
		text-decoration: none;
	}

	/* Kit row: the card is a panel, so focus outlines the whole card and prints the dot screen. */
	.card-link:focus-visible {
		outline: none;
	}

	.post-card:has(.card-link:focus-visible) {
		border-color: color-mix(in oklch, var(--color-orbit-accent) 60%, var(--color-orbit-hair-strong));
		outline: 3px solid var(--color-orbit-focus);
		outline-offset: 4px;
		background: conic-gradient(from 90deg at 1px 1px, transparent 75%, var(--fk-row-dot) 0) 0 0 / 3px 3px, var(--color-orbit-paper);
	}

	.card-link:focus-visible .card-title {
		color: var(--color-orbit-accent);
	}

	.post-card:has(.card-link:active) {
		background: conic-gradient(from 90deg at 1px 1px, transparent 75%, var(--fk-row-dot) 0) 0 0 / 2px 2px, var(--color-orbit-paper);
		translate: 0 1px;
	}

	.card-image {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-bottom: 1px solid var(--color-orbit-hair-strong);
		background: var(--color-orbit-surface);
	}

	.card-image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.card-body {
		display: grid;
		align-content: start;
		gap: 0.625rem;
		padding: 1.25rem 1.25rem 1.5rem;
	}

	.card-title {
		min-width: 0;
		overflow-wrap: break-word;
		color: var(--color-orbit-ink);
		font-size: 1.3125rem;
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: -0.015em;
		text-wrap: balance;
		transition: color var(--fk-step) var(--ease-orbit-out);
	}

	.card-excerpt {
		display: -webkit-box;
		overflow: hidden;
		color: var(--color-orbit-muted);
		font-size: 0.9375rem;
		line-height: 1.6;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
	}

	.card-tags {
		position: relative;
		z-index: 2;
		margin-top: auto;
		padding: 0 1.25rem 0.5rem;
	}

	@media (hover: hover) and (pointer: fine) {
		.post-card:hover {
			border-color: color-mix(in oklch, var(--color-orbit-accent) 60%, var(--color-orbit-hair-strong));
		}

		.post-card:hover:not(:has(.card-link:active)) {
			background: conic-gradient(from 90deg at 1px 1px, transparent 75%, var(--fk-row-dot) 0) 0 0 / 3px 3px, var(--color-orbit-paper);
		}

		.post-card:hover::after {
			inset: 0.5rem;
			opacity: 1;
		}

		.card-link:hover .card-title {
			color: var(--color-orbit-accent);
		}
	}
</style>
