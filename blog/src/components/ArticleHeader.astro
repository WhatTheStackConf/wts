---
import type { ContentBylineCredit, EditProxy, TaxonomyTerm } from "emdash";
import BylineAvatar from "./BylineAvatar.astro";
import SkyBand from "./SkyBand.astro";

interface Props {
	title: string;
	excerpt?: string;
	bylines?: ContentBylineCredit[];
	/** ISO timestamp and its YYYY-MM-DD date, both null for unpublished posts. */
	publishedTime: string | null;
	publishDate: string | null;
	readingTime: number;
	tags?: TaxonomyTerm[];
	edit: EditProxy;
}

const {
	title,
	excerpt,
	bylines = [],
	publishedTime,
	publishDate,
	readingTime,
	tags = [],
	edit,
} = Astro.props;
---

<SkyBand variant="article">
	<h1 class="sky-band-title" {...edit.title}>{title}</h1>
	{
		excerpt && (
			<p class="sky-band-lede" {...edit.excerpt}>
				{excerpt}
			</p>
		)
	}
	<dl class="title-block">
		{
			bylines.length > 0 && (
				<div class="title-block-cell title-block-byline">
					<dt class="meta-label">{bylines.length === 1 ? "Author" : "Authors"}</dt>
					{bylines.map((credit) => (
						<dd class="title-block-value byline">
							<BylineAvatar byline={credit.byline} class="byline-avatar" />
							<span>
								{credit.byline.displayName}
								{credit.roleLabel && <span class="byline-role">{credit.roleLabel}</span>}
							</span>
						</dd>
					))}
				</div>
			)
		}
		{
			publishDate && (
				<div class="title-block-cell">
					<dt class="meta-label">Published</dt>
					<dd class="title-block-value">
						<time datetime={publishedTime}>{publishDate}</time>
					</dd>
				</div>
			)
		}
		<div class="title-block-cell">
			<dt class="meta-label">Reading time</dt>
			<dd class="title-block-value">{readingTime} min</dd>
		</div>
		{
			tags.length > 0 && (
				<div class="title-block-cell title-block-tags">
					<dt class="meta-label">Tags</dt>
					<dd class="tag-list">
						{tags.map((t) => (
							<a href={`/tag/${t.slug}`} class="tag-chip">
								<span>{t.label}</span>
							</a>
						))}
					</dd>
				</div>
			)
		}
	</dl>
</SkyBand>

<style>
	/* Title block: the drawing sheet's register of who, when, and how long. */
	.title-block {
		display: flex;
		flex-wrap: wrap;
		max-width: 64rem;
		margin-top: clamp(1.5rem, 3vw, 2.25rem);
		border-top: 1px solid var(--color-orbit-hair-strong);
	}

	.title-block-cell {
		display: grid;
		align-content: start;
		gap: 0.25rem;
		padding: 0.75rem clamp(1rem, 2.5vw, 2rem) 0;
		border-left: 1px solid var(--color-orbit-hair);
	}

	.title-block-cell:first-child {
		padding-left: 0;
		border-left: 0;
	}

	.title-block-value {
		color: var(--color-orbit-ink);
		font-size: 0.9375rem;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
	}

	.tag-list {
		margin-top: -0.5rem;
	}

	.byline {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.byline-avatar {
		width: var(--avatar-size-lg);
		height: var(--avatar-size-lg);
		border: 1px solid var(--color-orbit-hair-strong);
		object-fit: cover;
	}

	.byline-role {
		display: block;
		color: var(--color-orbit-muted);
		font-size: 0.8125rem;
		font-weight: 400;
	}

	@media (max-width: 599px) {
		.title-block-cell {
			padding-inline: 1rem;
		}

		.title-block-byline {
			flex-basis: 100%;
			padding-inline: 0;
			padding-bottom: 0.5rem;
		}

		.title-block-byline + .title-block-cell {
			padding-left: 0;
			border-left: 0;
		}

		.title-block-tags {
			flex-basis: 100%;
			padding-left: 0;
			border-left: 0;
		}
	}
</style>
