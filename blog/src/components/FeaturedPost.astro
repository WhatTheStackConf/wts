---
import type { ContentBylineCredit, EditProxy, MediaValue } from "emdash";
import { Image } from "emdash/ui";
import Arrow from "./Arrow.astro";
import BylineSummary from "./BylineSummary.astro";
import { formatUtcDate } from "../utils/date";

interface Props {
	title: string;
	excerpt?: string;
	featuredImage?: MediaValue | string;
	href: string;
	date?: Date | null;
	readingTime: number;
	tags: Array<{ slug: string; label: string }>;
	bylines?: ContentBylineCredit[];
	edit: EditProxy;
}

const {
	title,
	excerpt,
	featuredImage,
	href,
	date,
	readingTime,
	tags,
	bylines = [],
	edit,
} = Astro.props;
---

<article class="featured hair-panel" data-marks data-has-image={featuredImage ? "" : undefined}>
	{
		featuredImage && (
			<div class="featured-image" {...edit.featured_image}>
				<Image image={featuredImage} priority />
			</div>
		)
	}
	<div class="featured-content">
		<div class="featured-meta meta-label meta-row">
			{date && <time datetime={date.toISOString()}>{formatUtcDate(date)}</time>}
			<span>{readingTime} min read</span>
			{bylines.length > 0 && <BylineSummary credits={bylines} shown={2} variant="featured" />}
		</div>
		<h2 class="featured-title" {...edit.title}>
			<a href={href}>{title}</a>
		</h2>
		{
			excerpt && (
				<p class="featured-excerpt" {...edit.excerpt}>
					{excerpt}
				</p>
			)
		}
		<div class="featured-footer">
			<span class="inline-action" aria-hidden="true">
				Read the post
				<Arrow />
			</span>
			{
				tags.length > 0 && (
					<div class="tag-list">
						{tags.map((tag) => (
							<a href={`/tag/${tag.slug}`} class="tag-chip">
								<span>{tag.label}</span>
							</a>
						))}
					</div>
				)
			}
		</div>
	</div>
</article>

<style>
	.featured {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
	}

	.featured[data-has-image] {
		grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
	}

	.featured-image {
		display: block;
		min-height: 100%;
		overflow: hidden;
		border-right: 1px solid var(--color-orbit-hair-strong);
		background: var(--color-orbit-surface);
	}

	.featured-image :global(img) {
		width: 100%;
		height: 100%;
		min-height: 22rem;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.featured-content {
		display: flex;
		min-width: 0;
		flex-direction: column;
		gap: 1rem;
		padding: clamp(1.5rem, 3.5vw, 3rem);
	}

	.featured-title {
		color: var(--color-orbit-ink);
		font-size: clamp(1.75rem, 3vw, 2.625rem);
		font-weight: 600;
		line-height: 1.12;
		letter-spacing: -0.025em;
		text-wrap: balance;
	}

	.featured-title a {
		color: inherit;
		text-decoration: none;
		transition: color var(--fk-step) var(--ease-orbit-out);
	}

	/* The title link covers the whole panel, so the image and "Read the post" open the post too. */
	.featured-title a::after {
		position: absolute;
		inset: 0;
		content: "";
	}

	.featured-title a:focus-visible {
		outline: none;
	}

	/* Kit row: focus outlines the whole panel and prints the dot screen; press makes it 2px. */
	.featured {
		transition: border-color var(--fk-step) var(--ease-orbit-out);
	}

	.featured:has(.featured-title a:focus-visible) {
		border-color: color-mix(in oklch, var(--color-orbit-accent) 60%, var(--color-orbit-hair-strong));
		outline: 3px solid var(--color-orbit-focus);
		outline-offset: 4px;
		background: conic-gradient(from 90deg at 1px 1px, transparent 75%, var(--fk-row-dot) 0) 0 0 / 3px 3px, var(--color-orbit-paper);
	}

	.featured-title a:focus-visible {
		color: var(--color-orbit-accent);
	}

	.featured:has(.featured-title a:active) {
		background: conic-gradient(from 90deg at 1px 1px, transparent 75%, var(--fk-row-dot) 0) 0 0 / 2px 2px, var(--color-orbit-paper);
		translate: 0 1px;
	}

	.featured-excerpt {
		max-width: 52ch;
		color: var(--color-orbit-muted);
		font-size: 1.0625rem;
		line-height: 1.65;
		text-wrap: pretty;
	}

	.featured-footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		margin-top: auto;
		padding-top: 1rem;
		border-top: 1px solid var(--color-orbit-hair);
	}

	/* Tags stay clickable above the panel-wide title link. */
	.featured-footer .tag-list {
		position: relative;
		z-index: 2;
	}

	.featured-bylines {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}

	.featured-byline {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
	}

	.featured-byline-avatar {
		width: var(--avatar-size-md);
		height: var(--avatar-size-md);
		border: 1px solid var(--color-orbit-hair-strong);
		object-fit: cover;
	}

	/* Without a cover: the title and the excerpt share the panel side by side. */
	@media (min-width: 901px) {
		.featured:not([data-has-image]) .featured-content {
			display: grid;
			grid-template-areas:
				"meta meta"
				"title excerpt"
				"footer footer";
			grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
			gap: 1.5rem clamp(2rem, 5vw, 4.5rem);
		}

		.featured:not([data-has-image]) .featured-meta {
			grid-area: meta;
		}

		.featured:not([data-has-image]) .featured-title {
			grid-area: title;
			font-size: clamp(2.25rem, 3.8vw, 3.25rem);
		}

		.featured:not([data-has-image]) .featured-excerpt {
			grid-area: excerpt;
			align-self: end;
		}

		.featured:not([data-has-image]) .featured-footer {
			grid-area: footer;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.featured:hover {
			border-color: color-mix(in oklch, var(--color-orbit-accent) 60%, var(--color-orbit-hair-strong));
		}

		.featured:hover:not(:has(.featured-title a:active)) {
			background: conic-gradient(from 90deg at 1px 1px, transparent 75%, var(--fk-row-dot) 0) 0 0 / 3px 3px, var(--color-orbit-paper);
		}

		.featured:hover .featured-title a {
			color: var(--color-orbit-accent);
		}
	}

	@media (max-width: 900px) {
		.featured[data-has-image] {
			grid-template-columns: minmax(0, 1fr);
		}

		.featured-image {
			border-right: 0;
			border-bottom: 1px solid var(--color-orbit-hair-strong);
		}

		.featured-image :global(img) {
			min-height: 0;
			aspect-ratio: 16 / 9;
		}
	}
</style>
