---
import type { ContentBylineCredit } from "emdash";
import BylineSummary from "./BylineSummary.astro";
import { formatUtcDate } from "../utils/date";

interface Props {
	bylines?: ContentBylineCredit[];
	date?: Date;
	readingTime?: number;
}

const { bylines = [], date, readingTime } = Astro.props;
const formattedDate = date ? formatUtcDate(date) : null;
---

<div class="card-meta meta-label meta-row">
	{date && formattedDate && <time datetime={date.toISOString()}>{formattedDate}</time>}
	{readingTime && <span>{readingTime} min read</span>}
	{bylines.length > 0 && <BylineSummary credits={bylines} shown={1} variant="card" moreTooltip />}
</div>

<style>
	.card-meta {
		white-space: nowrap;
	}

	.card-meta > :global(*) {
		min-width: 0;
	}

	/* Bylines: the first name, then "+N" with the rest in a tooltip. */
	.card-bylines {
		display: inline-flex;
		min-width: 0;
		align-items: center;
		gap: 0.25rem;
	}

	.card-byline {
		display: inline-flex;
		min-width: 0;
		align-items: center;
		gap: 0.375rem;
	}

	.card-byline-name {
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.card-byline-avatar {
		width: var(--avatar-size-xs);
		height: var(--avatar-size-xs);
		border: 1px solid var(--color-orbit-hair-strong);
		object-fit: cover;
	}

	/* The tooltip is the kit tooltip plate, in controls.css. */
	.byline-more {
		position: relative;
		cursor: default;
	}
</style>
