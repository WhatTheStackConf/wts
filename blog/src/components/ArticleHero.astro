---
import type { EditProxy } from "emdash";
import { Image } from "emdash/ui";
import type { Post } from "../../emdash-env";

interface Props {
	image: Post["featured_image"];
	edit: EditProxy;
}

const { image, edit } = Astro.props;
const caption = image?.meta?.caption;
---

{
	image && (
		<figure class="article-hero" {...edit.featured_image}>
			<div class="article-hero-frame">
				<Image image={image} priority />
			</div>
			{typeof caption === "string" && caption && <figcaption>{caption}</figcaption>}
		</figure>
	)
}

<style>
	/* Cover under the band: a hairline frame with a thin paper mat and four corner marks. */
	.article-hero {
		margin: 0;
	}

	.article-hero-frame {
		position: relative;
		padding: clamp(0.375rem, 0.8vw, 0.625rem);
		border: 1px solid var(--color-orbit-hair-strong);
		background: var(--color-orbit-paper);
	}

	/* Marks sit on the frame's corners, one hairline stronger than the frame. */
	.article-hero-frame::after {
		position: absolute;
		inset: -1px;
		background: var(--mark-tl), var(--mark-tr), var(--mark-bl), var(--mark-br);
		pointer-events: none;
		content: "";
	}

	.article-hero-frame :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		background: var(--color-orbit-surface);
	}

	.article-hero figcaption {
		max-width: 70ch;
		margin-top: 0.625rem;
		color: var(--color-orbit-muted);
		font-size: 0.8125rem;
		line-height: 1.5;
	}
</style>
