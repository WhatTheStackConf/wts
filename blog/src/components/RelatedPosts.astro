---
import type { ComponentProps } from "astro/types";
import PostCard from "./PostCard.astro";

interface Props {
	posts: ComponentProps<typeof PostCard>[];
}

const { posts } = Astro.props;
---

{
	posts.length > 0 && (
		<section class="more-posts" aria-labelledby="more-posts-title">
			<header class="section-head">
				<h2 id="more-posts-title">Continue reading</h2>
			</header>
			<div class="card-grid">
				{posts.map((card) => (
					<PostCard {...card} />
				))}
			</div>
		</section>
	)
}

<style>
	.more-posts {
		width: var(--page-width);
		margin: clamp(4rem, 9vw, 7rem) auto 0;
	}
</style>
