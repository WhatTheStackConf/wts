---
/** The site's link arrow (Phosphor arrow-right, bold). Outbound links tilt it up and to the right. */
interface Props {
	outbound?: boolean;
}

const { outbound = false } = Astro.props;
---

<span class:list={["link-arrow", { "link-arrow-outbound": outbound }]} aria-hidden="true">
	<svg viewBox="0 0 256 256" width="16" height="16" focusable="false">
		<path
			fill="currentColor"
			d="m224.49 136.49l-72 72a12 12 0 0 1-17-17L187 140H40a12 12 0 0 1 0-24h147l-51.49-51.52a12 12 0 0 1 17-17l72 72a12 12 0 0 1-.02 17.01"
		></path>
	</svg>
</span>
