---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";

import { applyCacheHints } from "../utils/cache-hints";
import Arrow from "../components/Arrow.astro";
import { isOutboundLink, menuLinkCurrent, menuLinkRel } from "../utils/menu-link";
import { fullPageTitle } from "../utils/page-title";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { siteBase, siteOrigin } from "../utils/site-url";
import "../styles/tokens.css";
import "../styles/theme.css";
import "../styles/chrome.css";
import "../styles/controls.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
applyCacheHints(Astro.cache, settingsResult.cacheHint, menuResult.cacheHint);

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settingsResult.data);
const fullTitle = fullPageTitle(title, siteTitle);

const menu = menuResult.data;
const menuItems = (menu?.items ?? []).map((item) => ({
	...item,
	rel: menuLinkRel(item.target),
	current: menuLinkCurrent(item.url, Astro.url.pathname),
	outbound: isOutboundLink(item.url, item.target),
}));

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical: canonical ?? new URL(Astro.url.pathname, siteBase(Astro.site, Astro.url)).href,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
	siteUrl: siteOrigin(Astro.site, Astro.url),
});

// Check if user is logged in (for showing admin link)
const isLoggedIn = !!Astro.locals.user;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link
			rel="preload"
			href="/fonts/starzoom-shavian.regular.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/space-grotesk-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>

		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		<EmDashBodyStart page={pageCtx} />
		<header class="site-header">
			<div class="site-header-inner">
				<a href="/" class="site-brand" aria-label="WhatTheStack blog home">
					<img src="/logo.svg" alt="" class="site-brand-logo" width="36" height="46" />
					<span class="site-brand-name">WhatTheStack</span>
					<span class="site-brand-label">Blog</span>
				</a>
				<nav class="site-nav" aria-label="Site navigation">
					{
						menuItems.map((item) => (
							<a href={item.url} target={item.target} rel={item.rel} aria-current={item.current}>
								{item.label}
							</a>
						))
					}
				</nav>
				<search class="site-search-landmark" aria-label="Site search">
					<span id="site-search-label" class="visually-hidden">Search blog content</span>
					<LiveSearch
						placeholder="Search posts"
						class="site-search"
						inputClass="site-search-input"
						resultsClass="site-search-results"
						resultClass="site-search-result"
						collections={["posts", "pages"]}
					/>
					<kbd class="site-search-key" aria-hidden="true">Ctrl K</kbd>
				</search>
				{
					isLoggedIn && (
						<a href="/_emdash/admin" class="site-admin">
							Admin
						</a>
					)
				}
			</div>
		</header>

		<main id="content" tabindex="-1">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="site-footer-top">
				<a href="/" class="site-footer-brand" aria-label="WhatTheStack blog home">
					<img src="/logo.svg" alt="" width="34" height="43" />
					<span>WhatTheStack<br /><strong>Blog</strong></span>
				</a>
				<p class="site-footer-tagline">{siteTagline}</p>
				<nav class="site-footer-links" aria-label="Footer">
					{
						menuItems.map((item) => (
							<a href={item.url} target={item.target} rel={item.rel} aria-current={item.current}>
								{item.label}
								<Arrow outbound={item.outbound} />
							</a>
						))
					}
					<a href="/rss.xml">
						RSS feed
						<Arrow />
					</a>
				</nav>
			</div>
			<div class="site-footer-widgets">
				<WidgetArea name="footer" />
			</div>
			<div class="site-footer-bottom">
				<span>Powered by <a href="https://emdashcms.com">EmDash</a></span>
			</div>
		</footer>

		<style is:global>
			/*
			 * Layer order: "base" sits below the unlayered theme.css and chrome.css,
			 * so those always win regardless of bundle order.
			 */
			@layer base;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-relaxed);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
					min-height: 100vh;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-brand);
					text-decoration: none;
					transition: color var(--transition-fast);
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					line-height: var(--leading-tight);
					font-weight: var(--font-weight-heading);
					letter-spacing: var(--tracking-snug);
				}
			}
		</style>

		<script>
			const header = document.querySelector<HTMLElement>(".site-header");
			const searchInput = document.querySelector<HTMLInputElement>(".site-search-input");
			const searchKey = document.querySelector<HTMLElement>(".site-search-key");
			searchInput?.setAttribute("aria-labelledby", "site-search-label");
			searchInput?.setAttribute("aria-keyshortcuts", "Control+K Meta+K");
			if (searchKey && /Mac|iPhone|iPad/.test(navigator.userAgent)) searchKey.textContent = "⌘ K";

			// Sky bands slide under the glass header by exactly its height.
			if (header) {
				new ResizeObserver(([entry]) => {
					const height = entry.borderBoxSize[0]?.blockSize ?? header.offsetHeight;
					document.documentElement.style.setProperty("--header-height", `${Math.round(height)}px`);
				}).observe(header);
			}

			// ⌘K / Ctrl+K to focus search
			document.addEventListener("keydown", (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key === "k") {
					e.preventDefault();
					searchInput?.focus();
				}
			});
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
