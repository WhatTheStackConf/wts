---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import FeaturedPost from "../components/FeaturedPost.astro";
import PostCard from "../components/PostCard.astro";
import { applyCacheHints } from "../utils/cache-hints";
import { getReadingTime } from "../utils/reading-time";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { toTagLinks } from "../utils/tag-links";

// Limit to what we render (1 featured + 6 grid). The DB does the slicing
// instead of fetching every post and discarding the tail in JS.
const POSTS_PER_PAGE = 7;

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: POSTS_PER_PAGE + 1, // +1 to detect "view all" need
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

applyCacheHints(Astro.cache, cacheHint);

// Trim the lookahead post used to detect overflow
const visiblePosts = posts.slice(0, POSTS_PER_PAGE);
const hasMorePosts = posts.length > POSTS_PER_PAGE;

// Feature the latest real post, even when it has no image. The rest fill the grid.
const [featuredPost, ...gridPosts] = visiblePosts;

// Single batched query for tags across the featured post + grid posts.
// Avoids the N+1 pattern of calling getEntryTerms() per entry.
// Bylines are already hydrated on entry.data.bylines by getEmDashCollection.
const tagsByEntry = await getTermsForEntries(
	"posts",
	visiblePosts.map((p) => p.data.id),
	"tag",
);

const gridPostsWithTags = gridPosts.map((post) => ({
	post,
	tags: toTagLinks(tagsByEntry.get(post.data.id)),
	bylines: post.data.bylines ?? [],
}));
---

<Base title={siteTitle} description={siteTagline}>
	<div class="home-content">
		<header class="home-heading">
			<h1 class="home-title">Blog</h1>
			<p>{siteTagline}</p>
		</header>
		{
			posts.length === 0 ? (
				<section class="empty-state">
					<h2>No posts yet</h2>
					<p>Create your first post in the admin panel.</p>
					<a href="/_emdash/admin/content/posts/new" class="btn">
						Create a post
					</a>
				</section>
			) : (
				<>
					{featuredPost && (
						<FeaturedPost
							title={featuredPost.data.title}
							excerpt={featuredPost.data.excerpt}
							featuredImage={featuredPost.data.featured_image}
							href={`/posts/${featuredPost.id}`}
							date={featuredPost.data.publishedAt}
							readingTime={getReadingTime(featuredPost.data.content)}
							tags={toTagLinks(tagsByEntry.get(featuredPost.data.id))}
							bylines={featuredPost.data.bylines}
							edit={featuredPost.edit}
						/>
					)}
					{gridPostsWithTags.length > 0 && (
						<section class="posts-section" aria-labelledby="latest-heading">
							<header class="section-header">
								<h2 class="section-title" id="latest-heading">Latest</h2>
								{hasMorePosts && (
									<a href="/posts" class="section-link">
										View all
									</a>
								)}
							</header>
							<div class="posts-grid">
								{gridPostsWithTags.map(({ post, tags, bylines }) => (
									<PostCard
										title={post.data.title ?? "Untitled"}
										excerpt={post.data.excerpt}
										featuredImage={post.data.featured_image}
										href={`/posts/${post.id}`}
										date={post.data.publishedAt ?? undefined}
										readingTime={getReadingTime(post.data.content)}
										tags={tags}
										bylines={bylines}
										edit={post.edit}
									/>
								))}
							</div>
						</section>
					)}
				</>
			)
		}
	</div>
</Base>

<style>
	.home-content {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6);
	}

	.home-heading {
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-6);
		border-bottom: 1px solid var(--color-border);
	}

	.home-title {
		min-width: 0;
		overflow-wrap: anywhere;
		font-size: clamp(2rem, 4vw, 3rem);
		line-height: var(--leading-tight);
	}

	.home-heading p {
		max-width: 65ch;
		margin-top: var(--spacing-2);
		color: var(--color-text-secondary);
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: var(--spacing-8);
		padding-bottom: var(--spacing-4);
		border-bottom: 1px solid var(--color-border);
	}

	.section-title {
		font-size: var(--font-size-sm);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: var(--tracking-wide);
		color: var(--color-text-secondary);
	}

	.section-link {
		min-height: 44px;
		display: inline-flex;
		align-items: center;
		font-size: var(--font-size-sm);
		color: var(--color-brand);
		text-decoration: underline;
		text-underline-offset: 0.2em;
		transition: color var(--transition-fast);
	}

	.section-link:hover {
		color: var(--color-brand-hover);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-12) var(--spacing-8);
	}

	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-3);
		padding-block: var(--spacing-12);
	}

	.empty-state h2 {
		font-size: var(--font-size-2xl);
		font-weight: var(--font-weight-heading);
	}

	.empty-state p {
		color: var(--color-text-secondary);
	}

	.btn {
		display: inline-flex;
		min-height: 44px;
		align-items: center;
		margin-top: var(--spacing-2);
		padding: var(--spacing-3) var(--spacing-5);
		background: var(--color-brand);
		color: var(--color-on-brand);
		text-decoration: none;
		border-radius: var(--radius);
		font-size: var(--font-size-sm);
		font-weight: 600;
		transition: background var(--transition-fast);
	}

	.btn:hover {
		background: var(--color-brand-hover);
		color: var(--color-on-brand);
	}

	@media (max-width: 900px) {
		.home-content {
			padding: var(--spacing-8) var(--spacing-4) var(--spacing-12);
		}

		.posts-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: var(--spacing-8) var(--spacing-6);
		}
	}

	@media (max-width: 600px) {
		.home-content {
			padding-inline: var(--spacing-4);
		}

		.home-heading {
			margin-bottom: var(--spacing-8);
		}

		.posts-grid {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--spacing-8);
		}
	}
</style>
