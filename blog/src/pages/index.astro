---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
} from "emdash";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import FeaturedPost from "../components/FeaturedPost.astro";
import PostCard from "../components/PostCard.astro";
import SkyBand from "../components/SkyBand.astro";
import { applyCacheHints } from "../utils/cache-hints";
import { getReadingTime } from "../utils/reading-time";
import { resolveBlogSiteIdentity } from "../utils/site-identity";
import { toTagLinks } from "../utils/tag-links";

// Limit to what we render (1 featured + 6 grid). The DB does the slicing
// instead of fetching every post and discarding the tail in JS.
const POSTS_PER_PAGE = 7;

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: POSTS_PER_PAGE + 1, // +1 to detect "view all" need
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

applyCacheHints(Astro.cache, cacheHint);

// Trim the lookahead post used to detect overflow
const visiblePosts = posts.slice(0, POSTS_PER_PAGE);
const hasMorePosts = posts.length > POSTS_PER_PAGE;

// Feature the latest real post, even when it has no image. The rest fill the grid.
const [featuredPost, ...gridPosts] = visiblePosts;

// Single batched query for tags across the featured post + grid posts.
// Avoids the N+1 pattern of calling getEntryTerms() per entry.
// Bylines are already hydrated on entry.data.bylines by getEmDashCollection.
const tagsByEntry = await getTermsForEntries(
	"posts",
	visiblePosts.map((p) => p.data.id),
	"tag",
);

const gridPostsWithTags = gridPosts.map((post) => ({
	post,
	tags: toTagLinks(tagsByEntry.get(post.data.id)),
	bylines: post.data.bylines ?? [],
}));
---

<Base title={siteTitle} description={siteTagline}>
	<SkyBand>
		<h1 class="sky-band-title">Blog</h1>
		<p class="sky-band-lede">{siteTagline}</p>
	</SkyBand>
	<div class="page-body">
		{
			posts.length === 0 ? (
				<section class="empty-state hair-panel" data-marks>
					<h2>No posts yet</h2>
					<p>Create your first post in the admin panel.</p>
					<a href="/_emdash/admin/content/posts/new" class="button">
						Create a post
					</a>
				</section>
			) : (
				<>
					{featuredPost && (
						<FeaturedPost
							title={featuredPost.data.title}
							excerpt={featuredPost.data.excerpt}
							featuredImage={featuredPost.data.featured_image}
							href={`/posts/${featuredPost.id}`}
							date={featuredPost.data.publishedAt}
							readingTime={getReadingTime(featuredPost.data.content)}
							tags={toTagLinks(tagsByEntry.get(featuredPost.data.id))}
							bylines={featuredPost.data.bylines}
							edit={featuredPost.edit}
						/>
					)}
					{gridPostsWithTags.length > 0 && (
						<section class="posts-section" aria-labelledby="latest-heading">
							<header class="section-head">
								<h2 id="latest-heading">Latest</h2>
								{hasMorePosts && (
									<a href="/posts" class="inline-action">
										View all
										<Arrow />
									</a>
								)}
							</header>
							<div class="card-grid">
								{gridPostsWithTags.map(({ post, tags, bylines }) => (
									<PostCard
										title={post.data.title ?? "Untitled"}
										excerpt={post.data.excerpt}
										featuredImage={post.data.featured_image}
										href={`/posts/${post.id}`}
										date={post.data.publishedAt ?? undefined}
										readingTime={getReadingTime(post.data.content)}
										tags={tags}
										bylines={bylines}
										edit={post.edit}
									/>
								))}
							</div>
						</section>
					)}
				</>
			)
		}
	</div>
</Base>

<style>
	.posts-section {
		margin-top: clamp(3rem, 7vw, 5rem);
	}

	.empty-state {
		display: grid;
		justify-items: start;
		gap: 0.75rem;
		padding: clamp(1.5rem, 4vw, 3rem);
	}

	.empty-state h2 {
		font-size: clamp(1.5rem, 3vw, 2rem);
	}

	.empty-state p {
		color: var(--color-orbit-muted);
	}
</style>
