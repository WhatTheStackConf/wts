---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { PortableText, WidgetArea } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import ArticleHeader from "../../components/ArticleHeader.astro";
import ArticleHero from "../../components/ArticleHero.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { applyCacheHints } from "../../utils/cache-hints";
import { absoluteImageUrl } from "../../utils/media-url";
import { getReadingTime } from "../../utils/reading-time";
import { getRelatedPostCards } from "../../utils/related-posts";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import { siteBase, siteOrigin } from "../../utils/site-url";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

applyCacheHints(Astro.cache, cacheHint);

// Featured image URL for the OG image fallback
const featuredImageUrl = absoluteImageUrl(
	post.data.featured_image,
	siteBase(Astro.site, Astro.url),
);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

// Generate SEO meta from content
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: siteOrigin(Astro.site, Astro.url),
	path: Astro.url.pathname.replace(/\/$/, ""),
	defaultOgImage: featuredImageUrl,
});

// Get reading time
const readingTime = getReadingTime(post.data.content);

const { cards: relatedPosts, cacheHint: relatedPostsCacheHint } = await getRelatedPostCards(
	post.id,
);
applyCacheHints(Astro.cache, relatedPostsCacheHint);

const publishedTime = post.data.publishedAt?.toISOString() ?? null;
const publishDate = publishedTime?.slice(0, 10) ?? null;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={publishedTime}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug }}
>
	<article class="article">
		<ArticleHeader
			title={post.data.title}
			excerpt={post.data.excerpt}
			bylines={post.data.bylines}
			publishedTime={publishedTime}
			publishDate={publishDate}
			readingTime={readingTime}
			tags={post.data.terms?.tag}
			edit={post.edit}
		/>

		<div class="article-grid">
			<div class="article-cover">
				<ArticleHero image={post.data.featured_image} edit={post.edit} />
			</div>

			<aside class="article-sidebar" aria-label="Article tools">
				<div class="sidebar-sticky">
					<TableOfContents />
					<div class="sidebar-widgets">
						<WidgetArea name="sidebar" />
					</div>
				</div>
			</aside>

			<div class="article-content prose">
				<PortableText value={post.data.content} />
			</div>
		</div>
	</article>

	<RelatedPosts posts={relatedPosts} />
</Base>

<style>
	/* Cover across both columns, then the table of contents beside the reading column. */
	.article-grid {
		display: grid;
		grid-template-areas:
			"cover cover"
			"toc content";
		grid-template-columns: 13rem minmax(0, 46rem);
		justify-content: center;
		gap: clamp(2rem, 4vw, 3rem) clamp(2.5rem, 5vw, 5rem);
		width: var(--page-width);
		margin: clamp(2rem, 4vw, 3rem) auto 0;
	}

	.article-grid:not(:has(.article-hero)) {
		grid-template-areas: "toc content";
	}

	.article-grid:not(:has(.article-hero)) .article-cover {
		display: none;
	}

	.article-cover {
		grid-area: cover;
		min-width: 0;
	}

	.article-sidebar {
		grid-area: toc;
	}

	.article-content {
		grid-area: content;
		min-width: 0;
	}

	.sidebar-sticky {
		position: sticky;
		top: calc(var(--header-height) + 2rem);
		display: grid;
		gap: 2rem;
	}

	.sidebar-widgets:not(:has(.widget-area)) {
		display: none;
	}

	/* Sidebar widgets follow the same hairline register as the table of contents. */
	.sidebar-widgets :global(.widget-area) {
		display: grid;
		gap: 1.5rem;
	}

	.sidebar-widgets :global(.widget) {
		padding-left: 1rem;
		border-left: 1px solid var(--color-orbit-hair-strong);
		color: var(--color-orbit-muted);
		font-size: 0.875rem;
	}

	.sidebar-widgets :global(.widget__title) {
		margin-bottom: 0.5rem;
		color: var(--color-orbit-accent);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.sidebar-widgets :global(:is(.widget-categories, .widget-recent-posts, .widget-archives, .widget-tags__cloud)) {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.sidebar-widgets :global(:is(.widget-categories, .widget-recent-posts, .widget-archives) li) {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.5rem;
		border-bottom: 1px solid var(--color-orbit-hair);
		font-variant-numeric: tabular-nums;
	}

	.sidebar-widgets :global(.widget-tags__cloud) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
	}

	.sidebar-widgets :global(.widget-tags__count) {
		display: none;
	}

	/* Widget links, tags and the search field use the kit recipes in controls.css. */
	.sidebar-widgets :global(.widget-search__button) {
		display: none;
	}

	/* One column: the table of contents gives way to the reading column, as before. */
	@media (max-width: 1100px) {
		.article-grid,
		.article-grid:not(:has(.article-hero)) {
			grid-template-areas:
				"cover"
				"content";
			grid-template-columns: minmax(0, 46rem);
		}

		.article-grid:not(:has(.article-hero)) {
			grid-template-areas: "content";
		}

		.article-sidebar {
			display: none;
		}
	}
</style>
