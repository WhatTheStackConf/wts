---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../layouts/Base.astro";
import Arrow from "../../components/Arrow.astro";
import BylineSummary from "../../components/BylineSummary.astro";
import SkyBand from "../../components/SkyBand.astro";
import { getReadingTime } from "../../utils/reading-time";

// Sort in the database rather than in JS — lets the DB use its index on
// published_at and avoids a full-table scan on the client.
const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Single batched query for tags across all posts, instead of one
// getEntryTerms() call per post (which would be N round-trips).
// Bylines are already hydrated on entry.data.bylines.
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);

const postsWithTags = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
	bylines: post.data.bylines ?? [],
}));

const formatDate = (date: Date) => date.toISOString().slice(0, 10);
const countLabel = `${posts.length} ${posts.length === 1 ? "article" : "articles"}${cursor ? " on this page" : ""}`;
---

<Base title="All Posts" description="Browse all blog posts">
	<SkyBand>
		<h1 class="sky-band-title">All posts</h1>
		<p class="sky-band-lede">{countLabel}</p>
	</SkyBand>

	<div class="page-body">
		{
			posts.length === 0 ? (
				<p class="empty-note">No posts yet.</p>
			) : (
				<ol class="register">
					{postsWithTags.map(({ post, tags, bylines }) => (
						<li class="register-row">
							<div class="register-date meta-label">
								{post.data.publishedAt ? (
									<time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
								) : (
									<span>Draft</span>
								)}
							</div>
							<article class="register-main">
								<h2 class="register-title" {...post.edit.title}>
									<a href={`/posts/${post.id}`}>{post.data.title}</a>
								</h2>
								{post.data.excerpt && (
									<p class="register-excerpt" {...post.edit.excerpt}>{post.data.excerpt}</p>
								)}
								<div class="register-meta meta-label meta-row">
									<span>{getReadingTime(post.data.content)} min read</span>
									{bylines.length > 0 && <BylineSummary credits={bylines} shown={2} variant="post" />}
								</div>
								{tags.length > 0 && (
									<div class="register-tags tag-list">
										{tags.slice(0, 3).map((t) => (
											<a href={`/tag/${t.slug}`} class="tag-chip">
												<span>{t.label}</span>
											</a>
										))}
									</div>
								)}
							</article>
							<span class="register-arrow">
								<Arrow />
							</span>
						</li>
					))}
				</ol>
			)
		}
		<nav class="pagination" aria-label="Pagination">
			{cursor && <a href="/posts" class="inline-action">First page</a>}
			{
				nextCursor && (
					<a href={`/posts?cursor=${encodeURIComponent(nextCursor)}`} class="inline-action" rel="next">
						Next page
						<Arrow />
					</a>
				)
			}
		</nav>
	</div>
</Base>

<style>
	/* The archive as a drawing register: date column, entry, arrow. */
	.register {
		margin: 0;
		padding: 0;
		border-bottom: 1px solid var(--color-orbit-hair);
		list-style: none;
	}

	.register-row {
		position: relative;
		display: grid;
		grid-template-columns: 9rem minmax(0, 1fr) 2rem;
		gap: 0.5rem clamp(1rem, 3vw, 2.5rem);
		padding: clamp(1.5rem, 3vw, 2rem) 0;
		border-top: 1px solid var(--color-orbit-ink);
	}

	.register-row + .register-row {
		border-top-color: var(--color-orbit-hair-strong);
	}

	.register-date {
		padding-top: 0.5rem;
		color: var(--color-orbit-ink);
	}

	.register-main {
		display: grid;
		gap: 0.625rem;
		max-width: 46rem;
	}

	.register-title {
		color: var(--color-orbit-ink);
		font-size: clamp(1.375rem, 2.6vw, 1.875rem);
		font-weight: 600;
		line-height: 1.18;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.register-title a {
		color: inherit;
		text-decoration: none;
		transition: color var(--fk-step) var(--ease-orbit-out);
	}

	/* The title link covers the row; tags stay clickable above it. */
	.register-title a::after {
		position: absolute;
		inset: 0;
		content: "";
	}

	.register-title a:focus-visible {
		outline: none;
	}

	/* Kit table row: hover and focus print the 3px dot screen, press makes it 2px. */
	.register-row:has(.register-title a:focus-visible) {
		outline: 3px solid var(--color-orbit-focus);
		outline-offset: 4px;
		background: conic-gradient(from 90deg at 1px 1px, transparent 75%, var(--fk-row-dot) 0) 0 0 / 3px 3px;
	}

	.register-title a:focus-visible {
		color: var(--color-orbit-accent);
	}

	.register-row:has(.register-title a:active) {
		background: conic-gradient(from 90deg at 1px 1px, transparent 75%, var(--fk-row-dot) 0) 0 0 / 2px 2px;
	}

	.register-excerpt {
		color: var(--color-orbit-muted);
		font-size: 1.0625rem;
		line-height: 1.6;
		text-wrap: pretty;
	}

	.register-tags {
		position: relative;
		z-index: 1;
		margin-top: -0.25rem;
	}

	.register-arrow {
		padding-top: 0.5rem;
		color: var(--color-orbit-accent);
		font-size: 1.125rem;
	}

	.post-bylines {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
	}

	.post-byline {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
	}

	.post-byline-avatar {
		width: var(--avatar-size-sm);
		height: var(--avatar-size-sm);
		border: 1px solid var(--color-orbit-hair-strong);
		object-fit: cover;
	}

	@media (hover: hover) and (pointer: fine) {
		.register-row:hover:not(:has(.register-title a:active)) {
			background: conic-gradient(from 90deg at 1px 1px, transparent 75%, var(--fk-row-dot) 0) 0 0 / 3px 3px;
		}

		.register-row:hover .register-title a {
			color: var(--color-orbit-accent);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.register-row:has(.register-title a:focus-visible) .register-arrow :global(.link-arrow) {
			transform: translateX(3px);
		}

		@media (hover: hover) and (pointer: fine) {
			.register-row:hover .register-arrow :global(.link-arrow) {
				transform: translateX(3px);
			}
		}
	}

	@media (max-width: 767px) {
		.register-row {
			grid-template-columns: minmax(0, 1fr) 1.5rem;
		}

		.register-date {
			grid-column: 1 / -1;
			padding-top: 0;
		}

		.register-arrow {
			grid-column: 2;
			grid-row: 2;
		}
	}
</style>
