---
import {
	getTaxonomyTermsWithCacheHint,
	getEmDashCollection,
	getTermsForEntries,
	decodeSlug,
} from "emdash";
import Base from "../../layouts/Base.astro";
import TermArchive from "../../components/TermArchive.astro";
import { getReadingTime } from "../../utils/reading-time";
import { toTagLinks } from "../../utils/tag-links";

const slug = decodeSlug(Astro.params.slug);
const termsResult = await getTaxonomyTermsWithCacheHint("tag", {
	includeCounts: false,
});
const term = slug ? termsResult.data.find((item) => item.slug === slug) : null;

if (!term) {
	return Astro.redirect("/404");
}

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(termsResult.cacheHint);
	Astro.cache.set(cacheHint);
}

// Single batched query for tags on every post tagged with this term,
// rather than calling getEntryTerms() per post.
const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);
const cards = posts.map((post) => ({
	title: post.data.title,
	excerpt: post.data.excerpt,
	featuredImage: post.data.featured_image,
	href: `/posts/${post.id}`,
	date: post.data.publishedAt ?? undefined,
	readingTime: getReadingTime(post.data.content),
	tags: toTagLinks(tagsByEntry.get(post.data.id)),
	bylines: post.data.bylines ?? [],
	edit: post.edit,
}));
---

<Base title={`Posts tagged "${term.label}"`} description={`All posts tagged with ${term.label}`}>
	<TermArchive
		kind="Tag"
		label={term.label}
		basePath={`/tag/${term.slug}`}
		cards={cards}
		cursor={cursor}
		nextCursor={nextCursor}
	/>
</Base>
