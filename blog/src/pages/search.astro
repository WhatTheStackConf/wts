---
export const prerender = false;

import { search } from "emdash";
import Base from "../layouts/Base.astro";
import Arrow from "../components/Arrow.astro";
import SkyBand from "../components/SkyBand.astro";

const query = Astro.url.searchParams.get("q")?.trim() || "";

// Use the FTS-backed search() API instead of loading every post and
// filtering in JS. FTS scales as the post count grows, returns ranked
// results, and handles tokenization/stemming. Templates that grep all
// post bodies in JS quickly become unusable past a few hundred posts.
const { items: results } = query
	? await search(query, { collections: ["posts"], limit: 30 })
	: { items: [] };

const summary = !query
	? "Search every post by title and text."
	: results.length === 0
		? `No results for “${query}”.`
		: `${results.length} result${results.length === 1 ? "" : "s"} for “${query}”.`;
---

<Base
	title={query ? `Search: ${query}` : "Search"}
	description="Search blog posts"
>
	<SkyBand>
		<h1 class="sky-band-title">Search</h1>
		<p class="sky-band-lede" role="status">{summary}</p>
		<form method="get" action="/search" class="search-form" role="search">
			<label for="site-search-query" class="visually-hidden">Search blog posts</label>
			<input
				id="site-search-query"
				type="search"
				name="q"
				value={query}
				placeholder="Search posts"
				class="search-input"
				autofocus
			/>
			<button type="submit" class="button search-button">Search</button>
		</form>
	</SkyBand>

	<div class="page-body">
		{
			results.length > 0 ? (
				<ol class="search-results">
					{results.map((result) => (
						<li class="search-result">
							<a href={`/posts/${result.slug ?? result.id}`} class="result-link">
								<h2 class="result-title">{result.title ?? "Untitled"}</h2>
								{result.snippet && <p class="result-snippet" set:html={result.snippet} />}
							</a>
							<span class="result-arrow">
								<Arrow />
							</span>
						</li>
					))}
				</ol>
			) : (
				query && (
					<p class="empty-note">
						Try a shorter phrase, or <a href="/posts">browse all posts</a>.
					</p>
				)
			)
		}
	</div>
</Base>

<style>
	/* The field is the kit field and the button is the kit plate (controls.css). */
	.search-form {
		display: flex;
		gap: 0.5rem;
		max-width: 40rem;
		margin-top: clamp(1.25rem, 3vw, 2rem);
	}

	.search-input {
		flex: 1;
	}

	.search-button {
		flex-shrink: 0;
	}

	.search-results {
		margin: 0;
		padding: 0;
		border-bottom: 1px solid var(--color-orbit-hair);
		list-style: none;
	}

	.search-result {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 46rem) 2rem;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.5rem 0;
		border-top: 1px solid var(--color-orbit-hair-strong);
	}

	.search-result:first-child {
		border-top-color: var(--color-orbit-ink);
	}

	.result-link {
		display: grid;
		gap: 0.5rem;
		color: inherit;
		text-decoration: none;
	}

	.result-link::after {
		position: absolute;
		inset: 0;
		content: "";
	}

	.result-link:focus-visible {
		outline: none;
	}

	/* Kit table row: hover and focus print the 3px dot screen, press makes it 2px. */
	.search-result:has(.result-link:focus-visible) {
		outline: 3px solid var(--color-orbit-focus);
		outline-offset: 4px;
		background: conic-gradient(from 90deg at 1px 1px, transparent 75%, var(--fk-row-dot) 0) 0 0 / 3px 3px;
	}

	.result-link:focus-visible .result-title {
		color: var(--color-orbit-accent);
	}

	.search-result:has(.result-link:active) {
		background: conic-gradient(from 90deg at 1px 1px, transparent 75%, var(--fk-row-dot) 0) 0 0 / 2px 2px;
	}

	.result-title {
		font-size: clamp(1.25rem, 2.2vw, 1.5rem);
		font-weight: 600;
		line-height: 1.25;
		letter-spacing: -0.015em;
		transition: color var(--fk-step) var(--ease-orbit-out);
	}

	.result-snippet {
		color: var(--color-orbit-muted);
		font-size: 1rem;
		line-height: 1.6;
	}

	/* FTS wraps the matched terms in <mark>. */
	.result-snippet :global(mark) {
		padding: 0 0.1em;
		background: color-mix(in oklch, var(--launch-cyan) 45%, transparent);
		color: var(--color-orbit-ink);
	}

	.result-arrow {
		color: var(--color-orbit-accent);
		font-size: 1.125rem;
	}

	@media (hover: hover) and (pointer: fine) {
		.search-result:hover:not(:has(.result-link:active)) {
			background: conic-gradient(from 90deg at 1px 1px, transparent 75%, var(--fk-row-dot) 0) 0 0 / 3px 3px;
		}

		.search-result:hover .result-title {
			color: var(--color-orbit-accent);
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.search-result:has(.result-link:focus-visible) .result-arrow :global(.link-arrow) {
			transform: translateX(3px);
		}

		@media (hover: hover) and (pointer: fine) {
			.search-result:hover .result-arrow :global(.link-arrow) {
				transform: translateX(3px);
			}
		}
	}
</style>
