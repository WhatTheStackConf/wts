---
import Base from "../layouts/Base.astro";
import SkyBand from "../components/SkyBand.astro";
---

<Base title="Page not found">
	<SkyBand context="404 · Not found" variant="lost">
		<h1 class="sky-band-title">This page isn’t here.</h1>
		<p class="sky-band-lede">The address may be outdated, or the post may have moved.</p>
		<nav class="lost-actions" aria-label="Not found navigation">
			<a href="/" class="button">Blog home</a>
			<a href="/posts" class="button button-ghost">All posts</a>
		</nav>
	</SkyBand>
</Base>

<style>
	.lost-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}
</style>
