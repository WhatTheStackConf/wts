{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "runtime/checkin",
    "outDir": ".output/checkin-runtime",
    "noEmitOnError": true
  },
  "include": ["runtime/checkin/**/*.ts"]
}
