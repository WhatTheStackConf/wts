{
  "name": "@wts/design",
  "private": true,
  "type": "module",
  "description": "Storybook for the WTS 2027 design system. It renders the real CSS and components of site, cfp, auth and blog.",
  "engines": { "node": ">=24.15.0" },
  "scripts": {
    "storybook": "storybook dev --port 6007 --host 127.0.0.1 --no-open",
